{
  "name": "map-priority-workflow",
  "description": "A map-centric workflow for the A Whittle Wandering project that prioritizes mapping functionality",
  "version": "1.0.0",
  "agents": [
    {
      "id": "map-specialist",
      "name": "Map Specialist Agent",
      "mcp_config": "./configs/map-specialist-mcp.json",
      "prompt_template": "./prompts/map-specialist-agent.md",
      "priority": "highest",
      "dependencies": []
    },
    {
      "id": "weather-integration",
      "name": "Weather Integration Agent",
      "mcp_config": "./configs/weather-integration-mcp.json",
      "prompt_template": "./prompts/weather-integration-agent.md",
      "priority": "high",
      "dependencies": ["map-specialist"]
    },
    {
      "id": "ui-enhancement",
      "name": "UI/UX Enhancement Agent",
      "mcp_config": "./configs/ui-enhancement-mcp.json",
      "prompt_template": "./prompts/ui-enhancement-agent.md",
      "priority": "medium",
      "dependencies": ["map-specialist"]
    },
    {
      "id": "devops",
      "name": "DevOps Agent",
      "mcp_config": "./configs/devops-agent-mcp.json",
      "prompt_template": "./prompts/devops-agent.md",
      "priority": "medium",
      "dependencies": []
    }
  ],
  "tasks": [
    {
      "id": "configure-map-tokens",
      "description": "Configure secure handling of map service tokens",
      "agent_id": "devops",
      "priority": "critical",
      "dependencies": [],
      "artifacts": [
        ".env.example", 
        "edge-worker/.env"
      ]
    },
    {
      "id": "enhance-map-component",
      "description": "Enhance core map rendering and interaction components",
      "agent_id": "map-specialist",
      "priority": "critical",
      "dependencies": ["configure-map-tokens"],
      "artifacts": [
        "48Continental_Starter/public-site/app.js"
      ]
    },
    {
      "id": "implement-weather-integration",
      "description": "Implement weather data retrieval and visualization",
      "agent_id": "weather-integration",
      "priority": "high",
      "dependencies": ["enhance-map-component"],
      "artifacts": [
        "edge-worker/src/weather/",
        "48Continental_Starter/public-site/app.js"
      ]
    },
    {
      "id": "optimize-map-performance",
      "description": "Optimize map rendering and interaction performance",
      "agent_id": "map-specialist",
      "priority": "high",
      "dependencies": ["enhance-map-component"],
      "artifacts": [
        "48Continental_Starter/public-site/app.js"
      ]
    },
    {
      "id": "create-route-timeline",
      "description": "Implement interactive timeline for route history",
      "agent_id": "ui-enhancement",
      "priority": "medium",
      "dependencies": ["enhance-map-component"],
      "artifacts": [
        "48Continental_Starter/public-site/app.js",
        "48Continental_Starter/public-site/index.html",
        "48Continental_Starter/public-site/style.css"
      ]
    },
    {
      "id": "implement-poi-integration",
      "description": "Integrate points of interest with map display",
      "agent_id": "map-specialist",
      "priority": "medium",
      "dependencies": ["enhance-map-component"],
      "artifacts": [
        "48Continental_Starter/public-site/app.js"
      ]
    },
    {
      "id": "implement-weather-alerts",
      "description": "Implement weather alerts and notifications",
      "agent_id": "weather-integration",
      "priority": "medium",
      "dependencies": ["implement-weather-integration"],
      "artifacts": [
        "edge-worker/src/weather/alerts.ts",
        "48Continental_Starter/public-site/app.js"
      ]
    },
    {
      "id": "optimize-responsive-layout",
      "description": "Optimize UI for various screen sizes and devices",
      "agent_id": "ui-enhancement",
      "priority": "medium",
      "dependencies": [],
      "artifacts": [
        "48Continental_Starter/public-site/index.html",
        "48Continental_Starter/public-site/style.css"
      ]
    },
    {
      "id": "setup-deployment-pipeline",
      "description": "Set up automated deployment pipeline for all components",
      "agent_id": "devops",
      "priority": "high",
      "dependencies": [],
      "artifacts": [
        ".github/workflows/",
        "scripts/deploy-all.sh"
      ]
    },
    {
      "id": "implement-monitoring",
      "description": "Set up performance monitoring and alerting",
      "agent_id": "devops",
      "priority": "medium",
      "dependencies": ["setup-deployment-pipeline"],
      "artifacts": [
        "edge-worker/src/utils/monitoring.ts"
      ]
    },
    {
      "id": "integration-testing",
      "description": "Perform integration testing of all components",
      "agent_id": "devops",
      "priority": "high",
      "dependencies": [
        "enhance-map-component",
        "implement-weather-integration",
        "optimize-map-performance",
        "create-route-timeline",
        "implement-poi-integration",
        "optimize-responsive-layout"
      ],
      "artifacts": [
        "edge-worker/src/__tests__/"
      ]
    },
    {
      "id": "production-deployment",
      "description": "Deploy all components to production",
      "agent_id": "devops",
      "priority": "critical",
      "dependencies": ["integration-testing"],
      "artifacts": [
        "scripts/deploy-all.sh"
      ]
    }
  ],
  "schedule": {
    "type": "parallel",
    "max_parallel_tasks": 4,
    "priority_scheduling": true,
    "daily_sync_time": "09:00",
    "progress_update_interval": "4h",
    "estimated_completion": "2025-06-15T17:00:00Z"
  },
  "monitoring": {
    "alert_on_failure": true,
    "alert_channels": ["slack", "email"],
    "progress_dashboard_url": "https://a-whittle-wandering.dashboard/progress",
    "performance_metrics": ["task_completion_rate", "code_quality", "test_coverage"],
    "status_update_interval": "6h"
  },
  "emergency_procedures": {
    "on_failure": {
      "retry_count": 2,
      "notify_human": true,
      "fallback_to_stable": true
    },
    "on_conflict": {
      "resolution_strategy": "priority_agent_wins",
      "notify_human": true,
      "log_conflict_details": true
    }
  }
}
