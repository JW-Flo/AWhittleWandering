{
  "name": "devops-tools",
  "version": "1.0.0",
  "description": "Tool definitions for DevOps functionality in the A Whittle Wandering project",
  "tools": [
    {
      "name": "manage_environment_variables",
      "description": "Manages environment variables for different deployment environments",
      "parameters": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "action": {
            "type": "string",
            "enum": ["get", "set", "list", "delete"]
          },
          "key": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["environment", "action"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "variables": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "implementation": {
        "file": "../scripts/devops-tools/env-manager.js",
        "function": "manageEnvironmentVariables"
      }
    },
    {
      "name": "deploy_service",
      "description": "Deploys a service to the specified environment",
      "parameters": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["edge-worker", "public-site", "mobile-app", "route-tracker"]
          },
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "version": { "type": "string" },
          "deploymentStrategy": {
            "type": "string",
            "enum": ["blue-green", "canary", "standard"]
          }
        },
        "required": ["service", "environment"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "deploymentId": { "type": "string" },
          "url": { "type": "string" },
          "timestamp": { "type": "string" },
          "logs": { "type": "string" },
          "duration": { "type": "number" }
        }
      },
      "implementation": {
        "file": "../scripts/devops-tools/deployment.js",
        "function": "deployService"
      }
    },
    {
      "name": "monitor_service_health",
      "description": "Monitors the health and performance of deployed services",
      "parameters": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["edge-worker", "public-site", "mobile-app", "route-tracker"]
          },
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["cpu", "memory", "requests", "errors", "latency", "availability"]
            }
          },
          "timeRange": { "type": "string" }
        },
        "required": ["service"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "uptime": { "type": "number" },
          "availability": { "type": "number" },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "current": { "type": "number" },
                "average": { "type": "number" },
                "peak": { "type": "number" },
                "trend": { "type": "string" }
              }
            }
          },
          "alerts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "severity": { "type": "string" },
                "message": { "type": "string" },
                "timestamp": { "type": "string" }
              }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/devops-tools/health-monitor.js",
        "function": "monitorServiceHealth"
      }
    },
    {
      "name": "manage_api_keys",
      "description": "Manages API keys for third-party services",
      "parameters": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["mapbox", "weather-api", "analytics", "tessie"]
          },
          "action": {
            "type": "string",
            "enum": ["rotate", "validate", "status"]
          },
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          }
        },
        "required": ["service", "action"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "key": { "type": "string" },
          "status": { "type": "string" },
          "expiresAt": { "type": "string" },
          "usageStats": {
            "type": "object",
            "properties": {
              "daily": { "type": "number" },
              "monthly": { "type": "number" },
              "remaining": { "type": "number" }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/devops-tools/api-key-manager.js",
        "function": "manageApiKeys"
      }
    },
    {
      "name": "manage_cloudflare_worker",
      "description": "Manages Cloudflare Worker deployment and configuration",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["deploy", "rollback", "status", "logs", "configure"]
          },
          "worker": {
            "type": "string",
            "enum": ["edge-worker", "route-tracker"]
          },
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "version": { "type": "string" },
          "configParams": { "type": "object" }
        },
        "required": ["action", "worker"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "deploymentId": { "type": "string" },
          "url": { "type": "string" },
          "version": { "type": "string" },
          "status": { "type": "string" },
          "logs": { "type": "string" },
          "config": { "type": "object" }
        }
      },
      "implementation": {
        "file": "../scripts/devops-tools/cloudflare-manager.js",
        "function": "manageCloudflareWorker"
      }
    }
  ],
  "dependencies": [
    {
      "name": "wrangler",
      "version": "^3.0.0"
    },
    {
      "name": "dotenv",
      "version": "^16.3.1"
    },
    {
      "name": "@cloudflare/wrangler",
      "version": "^3.0.0"
    },
    {
      "name": "pm2",
      "version": "^5.3.0"
    }
  ]
}
