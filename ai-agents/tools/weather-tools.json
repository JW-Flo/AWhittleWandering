{
  "name": "weather-tools",
  "version": "1.0.0",
  "description": "Tool definitions for weather-related functionality in the A Whittle Wandering project",
  "tools": [
    {
      "name": "get_current_weather",
      "description": "Retrieves current weather conditions for a location",
      "parameters": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            },
            "required": ["lat", "lng"]
          },
          "units": {
            "type": "string",
            "enum": ["imperial", "metric"]
          }
        },
        "required": ["location"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "temperature": { "type": "number" },
          "feelsLike": { "type": "number" },
          "humidity": { "type": "number" },
          "windSpeed": { "type": "number" },
          "windDirection": { "type": "number" },
          "precipitation": { "type": "number" },
          "condition": { "type": "string" },
          "icon": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      },
      "implementation": {
        "file": "../scripts/weather-tools/current-weather.js",
        "function": "getCurrentWeather"
      }
    },
    {
      "name": "get_weather_forecast",
      "description": "Retrieves weather forecast for a location",
      "parameters": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            },
            "required": ["lat", "lng"]
          },
          "days": { "type": "number" },
          "hourly": { "type": "boolean" },
          "units": {
            "type": "string",
            "enum": ["imperial", "metric"]
          }
        },
        "required": ["location"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "daily": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": { "type": "string" },
                "tempHigh": { "type": "number" },
                "tempLow": { "type": "number" },
                "precipitation": { "type": "number" },
                "precipProbability": { "type": "number" },
                "windSpeed": { "type": "number" },
                "condition": { "type": "string" },
                "icon": { "type": "string" }
              }
            }
          },
          "hourly": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timestamp": { "type": "string" },
                "temperature": { "type": "number" },
                "feelsLike": { "type": "number" },
                "precipitation": { "type": "number" },
                "precipProbability": { "type": "number" },
                "windSpeed": { "type": "number" },
                "condition": { "type": "string" },
                "icon": { "type": "string" }
              }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/weather-tools/forecast.js",
        "function": "getWeatherForecast"
      }
    },
    {
      "name": "get_route_weather",
      "description": "Retrieves weather conditions along a route",
      "parameters": {
        "type": "object",
        "properties": {
          "route": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lat": { "type": "number" },
                "lng": { "type": "number" },
                "timestamp": { "type": "string" }
              },
              "required": ["lat", "lng"]
            }
          },
          "resolution": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "includeAlerts": { "type": "boolean" },
          "units": {
            "type": "string",
            "enum": ["imperial", "metric"]
          }
        },
        "required": ["route"]
      },
      "returns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "location": {
              "type": "object",
              "properties": {
                "lat": { "type": "number" },
                "lng": { "type": "number" }
              }
            },
            "timestamp": { "type": "string" },
            "temperature": { "type": "number" },
            "condition": { "type": "string" },
            "precipitation": { "type": "number" },
            "windSpeed": { "type": "number" },
            "alerts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "severity": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/weather-tools/route-weather.js",
        "function": "getRouteWeather"
      }
    },
    {
      "name": "get_weather_alerts",
      "description": "Retrieves weather alerts for a location or region",
      "parameters": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            }
          },
          "boundingBox": {
            "type": "object",
            "properties": {
              "southwest": {
                "type": "object",
                "properties": {
                  "lat": { "type": "number" },
                  "lng": { "type": "number" }
                },
                "required": ["lat", "lng"]
              },
              "northeast": {
                "type": "object",
                "properties": {
                  "lat": { "type": "number" },
                  "lng": { "type": "number" }
                },
                "required": ["lat", "lng"]
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": ["all", "minor", "moderate", "severe", "extreme"]
          }
        }
      },
      "returns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string" },
            "severity": { "type": "string" },
            "headline": { "type": "string" },
            "description": { "type": "string" },
            "area": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "coordinates": { "type": "array" }
              }
            },
            "onset": { "type": "string" },
            "expires": { "type": "string" },
            "source": { "type": "string" }
          }
        }
      },
      "implementation": {
        "file": "../scripts/weather-tools/alerts.js",
        "function": "getWeatherAlerts"
      }
    },
    {
      "name": "create_weather_overlay",
      "description": "Creates a weather visualization overlay for the map",
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["precipitation", "temperature", "wind", "clouds", "pressure"]
          },
          "zoom": { "type": "number" },
          "opacity": { "type": "number" },
          "colorScheme": { "type": "string" }
        },
        "required": ["type"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "bounds": {
            "type": "object",
            "properties": {
              "west": { "type": "number" },
              "south": { "type": "number" },
              "east": { "type": "number" },
              "north": { "type": "number" }
            }
          },
          "timestamp": { "type": "string" },
          "attribution": { "type": "string" },
          "legend": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "color": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/weather-tools/weather-overlay.js",
        "function": "createWeatherOverlay"
      }
    }
  ],
  "dependencies": [
    {
      "name": "weather-api-client",
      "version": "^1.5.3"
    },
    {
      "name": "geolib",
      "version": "^3.3.4"
    }
  ]
}
