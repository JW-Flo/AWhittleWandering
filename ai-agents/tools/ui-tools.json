{
  "name": "ui-tools",
  "version": "1.0.0",
  "description": "Tool definitions for UI/UX-related functionality in the A Whittle Wandering project",
  "tools": [
    {
      "name": "analyze_component_performance",
      "description": "Analyzes the performance of a UI component",
      "parameters": {
        "type": "object",
        "properties": {
          "componentId": { "type": "string" },
          "renderMetrics": { "type": "boolean" },
          "memoryUsage": { "type": "boolean" },
          "reRenderCount": { "type": "boolean" }
        },
        "required": ["componentId"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "renderTime": { "type": "number" },
          "memoryUsage": { "type": "number" },
          "reRenderCount": { "type": "number" },
          "domNodes": { "type": "number" },
          "bottlenecks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "issue": { "type": "string" },
                "impact": { "type": "string" },
                "recommendation": { "type": "string" }
              }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/ui-tools/performance-analyzer.js",
        "function": "analyzeComponentPerformance"
      }
    },
    {
      "name": "check_accessibility",
      "description": "Checks the accessibility compliance of UI components",
      "parameters": {
        "type": "object",
        "properties": {
          "componentId": { "type": "string" },
          "wcagLevel": {
            "type": "string",
            "enum": ["A", "AA", "AAA"]
          },
          "includeScreenReaderCheck": { "type": "boolean" },
          "includeKeyboardNavigation": { "type": "boolean" },
          "includeColorContrast": { "type": "boolean" }
        },
        "required": ["componentId"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "score": { "type": "number" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "element": { "type": "string" },
                "description": { "type": "string" },
                "impact": { "type": "string" },
                "recommendation": { "type": "string" }
              }
            }
          },
          "passedChecks": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "implementation": {
        "file": "../scripts/ui-tools/accessibility-checker.js",
        "function": "checkAccessibility"
      }
    },
    {
      "name": "optimize_responsive_layout",
      "description": "Provides suggestions for improving responsive layout",
      "parameters": {
        "type": "object",
        "properties": {
          "componentId": { "type": "string" },
          "breakpoints": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["xs", "sm", "md", "lg", "xl", "xxl"]
            }
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["mobile", "tablet", "desktop", "large-desktop"]
            }
          }
        },
        "required": ["componentId"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "breakpoint": { "type": "string" },
                "element": { "type": "string" },
                "issue": { "type": "string" },
                "recommendation": { "type": "string" },
                "codeSnippet": { "type": "string" }
              }
            }
          },
          "overallScore": { "type": "number" },
          "recommendations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "implementation": {
        "file": "../scripts/ui-tools/responsive-optimizer.js",
        "function": "optimizeResponsiveLayout"
      }
    },
    {
      "name": "analyze_bundle_size",
      "description": "Analyzes and provides suggestions to reduce bundle size",
      "parameters": {
        "type": "object",
        "properties": {
          "component": { "type": "string" },
          "includeNodeModules": { "type": "boolean" },
          "includeDynamicImports": { "type": "boolean" }
        },
        "required": ["component"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "totalSize": { "type": "number" },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "size": { "type": "number" },
                "percentage": { "type": "number" }
              }
            }
          },
          "largeModules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "size": { "type": "number" },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "size": { "type": "number" }
                    }
                  }
                }
              }
            }
          },
          "recommendations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "implementation": {
        "file": "../scripts/ui-tools/bundle-analyzer.js",
        "function": "analyzeBundleSize"
      }
    },
    {
      "name": "generate_animation",
      "description": "Generates animation code for UI transitions",
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["fade", "slide", "scale", "rotate", "custom"]
          },
          "duration": { "type": "number" },
          "easing": { "type": "string" },
          "targetElement": { "type": "string" },
          "targetState": { "type": "string" }
        },
        "required": ["type", "targetElement"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "css": { "type": "string" },
          "js": { "type": "string" },
          "html": { "type": "string" },
          "performance": {
            "type": "object",
            "properties": {
              "gpuAccelerated": { "type": "boolean" },
              "estimatedFps": { "type": "number" }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/ui-tools/animation-generator.js",
        "function": "generateAnimation"
      }
    }
  ],
  "dependencies": [
    {
      "name": "axe-core",
      "version": "^4.7.0"
    },
    {
      "name": "lighthouse",
      "version": "^10.0.0"
    },
    {
      "name": "webpack-bundle-analyzer",
      "version": "^4.9.0"
    }
  ]
}
