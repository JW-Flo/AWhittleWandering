{
  "name": "map-tools",
  "version": "1.0.0",
  "description": "Tool definitions for map-related functionality in the A Whittle Wandering project",
  "tools": [
    {
      "name": "get_map_token",
      "description": "Retrieves the Mapbox token from secure storage",
      "parameters": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "description": "The deployment environment (development, staging, production)"
          }
        },
        "required": ["environment"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The Mapbox API token"
          },
          "expiresAt": {
            "type": "string",
            "description": "The expiration timestamp for the token"
          }
        }
      },
      "implementation": {
        "file": "../scripts/map-tools/get-token.js",
        "function": "getMapboxToken"
      }
    },
    {
      "name": "optimize_route",
      "description": "Optimizes a route based on various parameters",
      "parameters": {
        "type": "object",
        "properties": {
          "start": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            },
            "required": ["lat", "lng"]
          },
          "end": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            },
            "required": ["lat", "lng"]
          },
          "waypoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lat": { "type": "number" },
                "lng": { "type": "number" }
              },
              "required": ["lat", "lng"]
            }
          },
          "considerWeather": { "type": "boolean" },
          "avoidTolls": { "type": "boolean" },
          "avoidHighways": { "type": "boolean" }
        },
        "required": ["start", "end"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "route": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lat": { "type": "number" },
                "lng": { "type": "number" }
              },
              "required": ["lat", "lng"]
            }
          },
          "distance": { "type": "number" },
          "duration": { "type": "number" },
          "alternativeRoutes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "route": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "lat": { "type": "number" },
                      "lng": { "type": "number" }
                    }
                  }
                },
                "distance": { "type": "number" },
                "duration": { "type": "number" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/map-tools/route-optimizer.js",
        "function": "optimizeRoute"
      }
    },
    {
      "name": "get_points_of_interest",
      "description": "Retrieves points of interest near a location or along a route",
      "parameters": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            }
          },
          "route": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lat": { "type": "number" },
                "lng": { "type": "number" }
              },
              "required": ["lat", "lng"]
            }
          },
          "radius": { "type": "number" },
          "categories": {
            "type": "array",
            "items": { "type": "string" }
          },
          "limit": { "type": "number" }
        }
      },
      "returns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "location": {
              "type": "object",
              "properties": {
                "lat": { "type": "number" },
                "lng": { "type": "number" }
              }
            },
            "category": { "type": "string" },
            "rating": { "type": "number" },
            "distance": { "type": "number" },
            "description": { "type": "string" },
            "images": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/map-tools/poi-finder.js",
        "function": "getPointsOfInterest"
      }
    },
    {
      "name": "analyze_map_performance",
      "description": "Analyzes map rendering performance and provides optimization suggestions",
      "parameters": {
        "type": "object",
        "properties": {
          "componentId": { "type": "string" },
          "deviceProfile": { "type": "string" },
          "metricsTimeframe": { "type": "string" }
        },
        "required": ["componentId"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "fps": { "type": "number" },
          "renderTime": { "type": "number" },
          "memoryUsage": { "type": "number" },
          "tileLoadTime": { "type": "number" },
          "bottlenecks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "issue": { "type": "string" },
                "impact": { "type": "string" },
                "recommendation": { "type": "string" }
              }
            }
          }
        }
      },
      "implementation": {
        "file": "../scripts/map-tools/performance-analyzer.js",
        "function": "analyzeMapPerformance"
      }
    }
  ],
  "dependencies": [
    {
      "name": "mapbox-gl",
      "version": "^2.15.0"
    },
    {
      "name": "@mapbox/mapbox-sdk",
      "version": "^0.15.2"
    },
    {
      "name": "turf",
      "version": "^3.0.14"
    }
  ]
}
