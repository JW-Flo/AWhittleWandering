{
  "name": "weather-integration-agent",
  "version": "1.0.0",
  "description": "Specialized agent for weather data integration and weather-aware route planning",
  "modelConfig": {
    "model": "gpt-4",
    "temperature": 0.3,
    "maxTokens": 4096
  },
  "promptFiles": [
    "../prompts/weather-integration-agent.md"
  ],
  "tools": [
    {
      "name": "weatherAPI",
      "description": "Interface to weather data APIs (OpenWeatherMap, etc.)",
      "schema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["openWeatherMap", "weatherApi", "visualCrossing", "noaa"]
          },
          "endpoint": {
            "type": "string",
            "enum": ["current", "forecast", "historical", "alerts"]
          },
          "location": {
            "type": "object",
            "properties": {
              "lat": {"type": "number"},
              "lng": {"type": "number"}
            },
            "required": ["lat", "lng"]
          },
          "options": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["provider", "endpoint", "location"]
      }
    },
    {
      "name": "weatherVisualizer",
      "description": "Generate weather overlays for map visualization",
      "schema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["heatmap", "iconOverlay", "routeHighlight", "alert"]
          },
          "data": {
            "type": "object"
          },
          "style": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["type", "data"]
      }
    },
    {
      "name": "routeOptimizer",
      "description": "Optimize routes based on weather conditions",
      "schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["optimize", "analyze", "recommend", "avoid"]
          },
          "route": {
            "type": "object"
          },
          "weatherData": {
            "type": "object"
          },
          "preferences": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["action", "route", "weatherData"]
      }
    }
  ],
  "requiredCredentials": [
    {
      "name": "OPENWEATHERMAP_API_KEY",
      "description": "API key for OpenWeatherMap API",
      "envVariable": "OPENWEATHERMAP_API_KEY"
    },
    {
      "name": "WEATHER_API_KEY",
      "description": "API key for Weather API",
      "envVariable": "WEATHER_API_KEY"
    }
  ],
  "dependencies": [
    {
      "agent": "map-integration-agent",
      "description": "Required for applying weather visualizations to map"
    }
  ],
  "outputFormats": [
    {
      "name": "weatherOverlay",
      "description": "Weather overlay component for map integration",
      "schema": {
        "type": "object",
        "properties": {
          "overlayType": {
            "type": "string"
          },
          "geoJSON": {
            "type": "object"
          },
          "styling": {
            "type": "object"
          }
        },
        "required": ["overlayType", "geoJSON"]
      }
    }
  ]
}
