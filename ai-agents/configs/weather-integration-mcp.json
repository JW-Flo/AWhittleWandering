{
  "schema_version": "v1",
  "name": "weather-integration-mcp",
  "description": "Weather Integration Agent for A Whittle Wandering project",
  "system_prompt": "You are a specialized AI agent focused on weather data integration for the 'A Whittle Wandering' project. Your expertise includes weather API integration, meteorological data processing, geospatial weather visualization, and weather prediction modeling. You prioritize accurate weather data retrieval, visualization, and integration with route planning.",
  "tools": [
    {
      "name": "get_current_weather",
      "description": "Retrieves current weather conditions for a location",
      "parameters": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            },
            "required": ["lat", "lng"]
          },
          "units": {
            "type": "string",
            "enum": ["imperial", "metric"]
          }
        },
        "required": ["location"]
      }
    },
    {
      "name": "get_weather_forecast",
      "description": "Retrieves weather forecast for a location",
      "parameters": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            },
            "required": ["lat", "lng"]
          },
          "days": { "type": "number" },
          "hourly": { "type": "boolean" },
          "units": {
            "type": "string",
            "enum": ["imperial", "metric"]
          }
        },
        "required": ["location"]
      }
    },
    {
      "name": "get_route_weather",
      "description": "Retrieves weather conditions along a route",
      "parameters": {
        "type": "object",
        "properties": {
          "route": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lat": { "type": "number" },
                "lng": { "type": "number" },
                "timestamp": { "type": "string" }
              },
              "required": ["lat", "lng"]
            }
          },
          "resolution": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "includeAlerts": { "type": "boolean" },
          "units": {
            "type": "string",
            "enum": ["imperial", "metric"]
          }
        },
        "required": ["route"]
      }
    },
    {
      "name": "get_weather_alerts",
      "description": "Retrieves weather alerts for a location or region",
      "parameters": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            }
          },
          "boundingBox": {
            "type": "object",
            "properties": {
              "southwest": {
                "type": "object",
                "properties": {
                  "lat": { "type": "number" },
                  "lng": { "type": "number" }
                },
                "required": ["lat", "lng"]
              },
              "northeast": {
                "type": "object",
                "properties": {
                  "lat": { "type": "number" },
                  "lng": { "type": "number" }
                },
                "required": ["lat", "lng"]
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": ["all", "minor", "moderate", "severe", "extreme"]
          }
        }
      }
    },
    {
      "name": "create_weather_overlay",
      "description": "Creates a weather visualization overlay for the map",
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["precipitation", "temperature", "wind", "clouds", "pressure"]
          },
          "zoom": { "type": "number" },
          "opacity": { "type": "number" },
          "colorScheme": { "type": "string" }
        },
        "required": ["type"]
      }
    }
  ],
  "completion_prompt": "Based on your expertise with weather data integration, please provide a solution for this issue.",
  "response_format": "markdown",
  "messages_per_conversation": 10,
  "temperature": 0.3,
  "top_p": 0.95,
  "max_tokens": 8192,
  "stop_sequences": [],
  "tool_choice": "auto",
  "tool_use": {
    "max_tool_calls": 5,
    "max_tool_call_tokens": 4096
  }
}
