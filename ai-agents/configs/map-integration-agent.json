{
  "name": "map-integration-agent",
  "version": "1.0.0",
  "description": "Specialized agent for Mapbox integration and map performance optimization",
  "modelConfig": {
    "model": "gpt-4",
    "temperature": 0.2,
    "maxTokens": 4096
  },
  "promptFiles": [
    "../prompts/map-integration-agent.md"
  ],
  "tools": [
    {
      "name": "mapboxGLJS",
      "description": "Interface to Mapbox GL JS API for map rendering and manipulation",
      "schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["initialize", "addLayer", "removeLayer", "updatePosition", "addRoute", "setStyle", "addMarker", "flyTo"]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["action"]
      }
    },
    {
      "name": "geoJSONProcessor",
      "description": "Process and transform GeoJSON data for map visualization",
      "schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["parse", "transform", "simplify", "merge", "filter"]
          },
          "data": {
            "type": "object"
          },
          "options": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["operation", "data"]
      }
    },
    {
      "name": "performanceMonitor",
      "description": "Monitor and optimize map rendering performance",
      "schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["startMonitoring", "getMetrics", "stopMonitoring", "optimizeLayers", "reduceDetail"]
          },
          "target": {
            "type": "string"
          },
          "threshold": {
            "type": "number"
          }
        },
        "required": ["action"]
      }
    }
  ],
  "requiredCredentials": [
    {
      "name": "MAPBOX_TOKEN",
      "description": "Access token for Mapbox GL JS API",
      "envVariable": "MAPBOX_TOKEN"
    }
  ],
  "dependencies": [
    {
      "agent": "weather-integration-agent",
      "description": "Required for weather overlay integration on map"
    },
    {
      "agent": "ui-enhancement-agent",
      "description": "Required for timeline controls integration with map"
    }
  ],
  "outputFormats": [
    {
      "name": "mapComponent",
      "description": "React component for map integration",
      "schema": {
        "type": "object",
        "properties": {
          "componentName": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["componentName", "code"]
      }
    }
  ]
}
