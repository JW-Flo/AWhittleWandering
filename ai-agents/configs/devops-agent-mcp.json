{
  "schema_version": "v1",
  "name": "devops-agent-mcp",
  "description": "DevOps Agent for A Whittle Wandering project",
  "system_prompt": "You are a specialized AI agent focused on DevOps for the 'A Whittle Wandering' project. Your expertise includes CI/CD pipelines, cloud infrastructure (AWS and Cloudflare), environment management, security practices, and performance monitoring. You prioritize automated deployments, secure environment configuration, and infrastructure optimization.",
  "tools": [
    {
      "name": "manage_environment_variables",
      "description": "Manages environment variables for different deployment environments",
      "parameters": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "action": {
            "type": "string",
            "enum": ["get", "set", "list", "delete"]
          },
          "key": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["environment", "action"]
      }
    },
    {
      "name": "deploy_service",
      "description": "Deploys a service to the specified environment",
      "parameters": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["edge-worker", "public-site", "mobile-app", "route-tracker"]
          },
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "version": { "type": "string" },
          "deploymentStrategy": {
            "type": "string",
            "enum": ["blue-green", "canary", "standard"]
          }
        },
        "required": ["service", "environment"]
      }
    },
    {
      "name": "monitor_service_health",
      "description": "Monitors the health and performance of deployed services",
      "parameters": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["edge-worker", "public-site", "mobile-app", "route-tracker"]
          },
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["cpu", "memory", "requests", "errors", "latency", "availability"]
            }
          },
          "timeRange": { "type": "string" }
        },
        "required": ["service"]
      }
    },
    {
      "name": "manage_api_keys",
      "description": "Manages API keys for third-party services",
      "parameters": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["mapbox", "weather-api", "analytics", "tessie"]
          },
          "action": {
            "type": "string",
            "enum": ["rotate", "validate", "status"]
          },
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          }
        },
        "required": ["service", "action"]
      }
    },
    {
      "name": "manage_cloudflare_worker",
      "description": "Manages Cloudflare Worker deployment and configuration",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["deploy", "rollback", "status", "logs", "configure"]
          },
          "worker": {
            "type": "string",
            "enum": ["edge-worker", "route-tracker"]
          },
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "version": { "type": "string" },
          "configParams": { "type": "object" }
        },
        "required": ["action", "worker"]
      }
    }
  ],
  "completion_prompt": "Based on your expertise with DevOps, please provide a solution for this issue.",
  "response_format": "markdown",
  "messages_per_conversation": 10,
  "temperature": 0.2,
  "top_p": 0.95,
  "max_tokens": 8192,
  "stop_sequences": [],
  "tool_choice": "auto",
  "tool_use": {
    "max_tool_calls": 5,
    "max_tool_call_tokens": 4096
  }
}
