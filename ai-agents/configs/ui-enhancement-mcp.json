{
  "schema_version": "v1",
  "name": "ui-enhancement-mcp",
  "description": "UI/UX Enhancement Agent for A Whittle Wandering project",
  "system_prompt": "You are a specialized AI agent focused on UI/UX enhancements for the 'A Whittle Wandering' project. Your expertise includes frontend frameworks, responsive design, UI performance optimization, accessibility standards, and animation techniques. You prioritize responsive layouts, accessible components, and intuitive user interactions.",
  "tools": [
    {
      "name": "analyze_component_performance",
      "description": "Analyzes the performance of a UI component",
      "parameters": {
        "type": "object",
        "properties": {
          "componentId": { "type": "string" },
          "renderMetrics": { "type": "boolean" },
          "memoryUsage": { "type": "boolean" },
          "reRenderCount": { "type": "boolean" }
        },
        "required": ["componentId"]
      }
    },
    {
      "name": "check_accessibility",
      "description": "Checks the accessibility compliance of UI components",
      "parameters": {
        "type": "object",
        "properties": {
          "componentId": { "type": "string" },
          "wcagLevel": {
            "type": "string",
            "enum": ["A", "AA", "AAA"]
          },
          "includeScreenReaderCheck": { "type": "boolean" },
          "includeKeyboardNavigation": { "type": "boolean" },
          "includeColorContrast": { "type": "boolean" }
        },
        "required": ["componentId"]
      }
    },
    {
      "name": "optimize_responsive_layout",
      "description": "Provides suggestions for improving responsive layout",
      "parameters": {
        "type": "object",
        "properties": {
          "componentId": { "type": "string" },
          "breakpoints": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["xs", "sm", "md", "lg", "xl", "xxl"]
            }
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["mobile", "tablet", "desktop", "large-desktop"]
            }
          }
        },
        "required": ["componentId"]
      }
    },
    {
      "name": "analyze_bundle_size",
      "description": "Analyzes and provides suggestions to reduce bundle size",
      "parameters": {
        "type": "object",
        "properties": {
          "component": { "type": "string" },
          "includeNodeModules": { "type": "boolean" },
          "includeDynamicImports": { "type": "boolean" }
        },
        "required": ["component"]
      }
    },
    {
      "name": "generate_animation",
      "description": "Generates animation code for UI transitions",
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["fade", "slide", "scale", "rotate", "custom"]
          },
          "duration": { "type": "number" },
          "easing": { "type": "string" },
          "targetElement": { "type": "string" },
          "targetState": { "type": "string" }
        },
        "required": ["type", "targetElement"]
      }
    }
  ],
  "completion_prompt": "Based on your expertise with UI/UX enhancements, please provide a solution for this issue.",
  "response_format": "markdown",
  "messages_per_conversation": 10,
  "temperature": 0.3,
  "top_p": 0.95,
  "max_tokens": 8192,
  "stop_sequences": [],
  "tool_choice": "auto",
  "tool_use": {
    "max_tool_calls": 5,
    "max_tool_call_tokens": 4096
  }
}
