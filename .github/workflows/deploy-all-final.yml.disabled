name: Deploy A Whittle Wandering

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:
    inputs:
      environment:
        description: "Deployment environment"
        required: true
        default: "production"
        type: choice
        options:
          - production
          - staging
      deploy_components:
        description: "Components to deploy"
        required: true
        default: "all"
        type: choice
        options:
          - all
          - public-site
          - edge-worker
          - mcp-server

env:
  NODE_VERSION: "18"

jobs:
  validate-env:
    name: Validate Environment
    runs-on: ubuntu-latest
    steps:
      - name: Check required secrets
        id: check-secrets
        run: |
          missing_secrets=()

          # Check for required secrets individually
          if [ -z "${{ secrets.CF_API_TOKEN }}" ]; then missing_secrets+=("CF_API_TOKEN"); fi
          if [ -z "${{ secrets.CF_ACCOUNT_ID }}" ]; then missing_secrets+=("CF_ACCOUNT_ID"); fi
          if [ -z "${{ secrets.TESSIE_API_TOKEN }}" ]; then missing_secrets+=("TESSIE_API_TOKEN"); fi
          if [ -z "${{ secrets.TESSIE_VIN }}" ]; then missing_secrets+=("TESSIE_VIN"); fi
          if [ -z "${{ secrets.OPENWEATHER_API_KEY }}" ]; then missing_secrets+=("OPENWEATHER_API_KEY"); fi
          if [ -z "${{ secrets.MAPBOX_TOKEN }}" ]; then missing_secrets+=("MAPBOX_TOKEN"); fi
          if [ -z "${{ secrets.EDGE_HMAC_KEY }}" ]; then missing_secrets+=("EDGE_HMAC_KEY"); fi

          # Check if any secrets are missing
          if [ ${#missing_secrets[@]} -gt 0 ]; then
            echo "::error::Missing required secrets: ${missing_secrets[*]}"
            echo "missing_count=${#missing_secrets[@]}" >> $GITHUB_OUTPUT
            echo "missing_secrets=${missing_secrets[*]}" >> $GITHUB_OUTPUT
            exit 1
          else
            echo "All required secrets are set"
            echo "missing_count=0" >> $GITHUB_OUTPUT
          fi
    outputs:
      missing_count: ${{ steps.check-secrets.outputs.missing_count }}
      missing_secrets: ${{ steps.check-secrets.outputs.missing_secrets }}

  deploy:
    name: Deploy A Whittle Wandering
    needs: validate-env
    if: needs.validate-env.outputs.missing_count == 0
    runs-on: ubuntu-latest
    env:
      CF_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
      CF_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
      TESSIE_API_TOKEN: ${{ secrets.TESSIE_API_TOKEN }}
      TESSIE_VIN: ${{ secrets.TESSIE_VIN }}
      OPENWEATHER_API_KEY: ${{ secrets.OPENWEATHER_API_KEY }}
      MAPBOX_TOKEN: ${{ secrets.MAPBOX_TOKEN }}
      EDGE_HMAC_KEY: ${{ secrets.EDGE_HMAC_KEY }}
      DEPLOYMENT_ENV: ${{ github.event.inputs.environment || 'production' }}
      DEPLOY_COMPONENTS: ${{ github.event.inputs.deploy_components || 'all' }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: "npm"

      - name: Install dependencies
        run: |
          npm ci
          # Install specific dependencies for deployment
          npm install -g wrangler@latest
          npm install -g dotenv-cli

      - name: Setup deployment environment
        run: |
          # Create or update .env file with GitHub secrets
          echo "CF_API_TOKEN=${{ secrets.CF_API_TOKEN }}" > .env
          echo "CF_ACCOUNT_ID=${{ secrets.CF_ACCOUNT_ID }}" >> .env
          echo "TESSIE_API_TOKEN=${{ secrets.TESSIE_API_TOKEN }}" >> .env
          echo "TESSIE_VIN=${{ secrets.TESSIE_VIN }}" >> .env
          echo "OPENWEATHER_API_KEY=${{ secrets.OPENWEATHER_API_KEY }}" >> .env
          echo "MAPBOX_TOKEN=${{ secrets.MAPBOX_TOKEN }}" >> .env
          echo "EDGE_HMAC_KEY=${{ secrets.EDGE_HMAC_KEY }}" >> .env
          echo "DEPLOYMENT_ENV=${{ env.DEPLOYMENT_ENV }}" >> .env

          # Make deployment scripts executable
          chmod +x scripts/*.sh scripts/*.js
          chmod +x 48Continental_Starter/public-site/scripts/*.sh
          
      - name: Validate tools and MCP components
        run: |
          echo "Running tools and MCP validation..."
          chmod +x scripts/validate-all-tools.sh
          ./scripts/validate-all-tools.sh
        continue-on-error: ${{ env.DEPLOYMENT_ENV == 'staging' }}

      - name: Deploy edge worker
        if: env.DEPLOY_COMPONENTS == 'all' || env.DEPLOY_COMPONENTS == 'edge-worker'
        run: |
          cd edge-worker
          npm ci
          echo "Deploying Edge Worker..."
          CLOUDFLARE_API_TOKEN=${{ secrets.CF_API_TOKEN }} CLOUDFLARE_ACCOUNT_ID=${{ secrets.CF_ACCOUNT_ID }} npx wrangler deploy
          echo "Edge Worker deployment completed"

      - name: Verify Mapbox token
        if: env.DEPLOY_COMPONENTS == 'all' || env.DEPLOY_COMPONENTS == 'public-site'
        run: |
          export VITE_MAPBOX_TOKEN="${{ secrets.MAPBOX_TOKEN }}"
          cd 48Continental_Starter/public-site
          ./scripts/verify-mapbox-token.sh || echo "Mapbox token verification warning - continuing deployment"

      - name: Deploy public site
        if: env.DEPLOY_COMPONENTS == 'all' || env.DEPLOY_COMPONENTS == 'public-site'
        run: |
          cd 48Continental_Starter/public-site
          npm ci
          npm run build
          echo "Deploying Public Site..."
          CLOUDFLARE_API_TOKEN=${{ secrets.CF_API_TOKEN }} CLOUDFLARE_ACCOUNT_ID=${{ secrets.CF_ACCOUNT_ID }} npx wrangler pages deploy dist --project-name="awhittlewandering-site" --branch="main"
          echo "Public Site deployment completed"

      - name: Run deployment script
        if: env.DEPLOY_COMPONENTS == 'all'
        run: |
          echo "Running main deployment script..."
          ./scripts/deploy-project.sh

      - name: Test API endpoints
        if: env.DEPLOY_COMPONENTS == 'all' || env.DEPLOY_COMPONENTS == 'edge-worker'
        run: |
          echo "Testing API endpoints..."
          NODE_OPTIONS="--unhandled-rejections=strict" node ./scripts/test-api-endpoints.js

      - name: Verify deployment
        if: env.DEPLOY_COMPONENTS == 'all'
        run: |
          echo "Verifying deployment..."
          node ./scripts/deployment-success-validator.js

      - name: Upload deployment report
        uses: actions/upload-artifact@v3
        with:
          name: deployment-report
          path: LATEST_DEPLOYMENT_REPORT.md
          retention-days: 30

      - name: Notify on success
        if: success()
        run: |
          echo "::notice::🎉 Deployment completed successfully! See the deployment report for details."

      - name: Notify on failure
        if: failure()
        run: |
          echo "::error::❌ Deployment failed. Check the logs for details."

  notify-missing-secrets:
    name: Notify Missing Secrets
    needs: validate-env
    if: needs.validate-env.outputs.missing_count != 0
    runs-on: ubuntu-latest
    steps:
      - name: Display missing secrets error
        run: |
          echo "::error::Deployment aborted. Missing required secrets: ${{ needs.validate-env.outputs.missing_secrets }}"
          echo "Please add the missing secrets to the repository settings."
          exit 1
