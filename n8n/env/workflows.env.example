# n8n Server Configuration
N8N_PORT=5678
N8N_AUTH_TOKEN=your_auth_token_here
N8N_ENCRYPTION_KEY=your_encryption_key_here

# Agent URLs
COPILOT_AGENT_URL=http://copilot:3000
CLINE_AGENT_URL=http://cline:3001
BLACKBOX_AGENT_URL=http://blackbox:3002
CLOUDFLARE_AGENT_URL=http://cloudflare:3003

# Agent Authentication
COPILOT_AGENT_SECRET=your_copilot_secret_here
CLINE_AGENT_SECRET=your_cline_secret_here
BLACKBOX_AGENT_SECRET=your_blackbox_secret_here
CLOUDFLARE_AGENT_SECRET=your_cloudflare_secret_here

# MCP Server Configuration
MCP_SERVER_URL=http://mcp-server:4000
MCP_SERVER_TOKEN=your_mcp_token_here

# GitHub Configuration
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name
GITHUB_TOKEN=your_github_token_here

# Webhook Security
WEBHOOK_HMAC_SECRET=your_webhook_secret_here
WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

# Security Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ENABLED=true
ENCRYPTION_ALGORITHM=aes-256-gcm

# Monitoring Configuration
ANALYTICS_ENABLED=true
METRICS_COLLECTION_INTERVAL=60
MONITORING_RETENTION_DAYS=30

# Alert Configuration
ALERT_EMAIL=alerts@yourdomain.com
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_CHANNEL=#monitoring

# Deployment Settings
DEPLOYMENT_TARGET=production
MAINTENANCE_MODE_ENABLED=true
GRADUAL_ROLLOUT_ENABLED=true

# Agent Roles and Permissions
COPILOT_ROLES=admin,task_manager,workflow_editor
CLINE_ROLES=executor,code_reviewer
BLACKBOX_ROLES=security_auditor,code_analyzer
CLOUDFLARE_ROLES=deployer,cdn_manager

# Performance Thresholds
MAX_CONCURRENT_EXECUTIONS=10
WORKFLOW_TIMEOUT_MS=300000
ERROR_RATE_THRESHOLD=0.05
RESPONSE_TIME_THRESHOLD_MS=5000

# Backup and Recovery
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
AUTO_RECOVERY_ENABLED=true
MAX_RECOVERY_RETRIES=3

# Logging Configuration
LOG_LEVEL=info
AUDIT_LOGGING_ENABLED=true
SENSITIVE_FIELDS=password,token,secret,key,authorization

# Integration Settings
SLACK_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
GITHUB_INTEGRATION_ENABLED=true

# Development Settings
NODE_ENV=production
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Additional Agent Settings
AGENT_HEALTH_CHECK_INTERVAL=60
AGENT_CONNECTION_TIMEOUT=5000
AGENT_RETRY_ATTEMPTS=3

# Task Management
TASK_QUEUE_SIZE=100
TASK_PRIORITY_LEVELS=low,medium,high,critical
TASK_RETENTION_DAYS=7

# Workflow Settings
WORKFLOW_VALIDATION_REQUIRED=true
WORKFLOW_SCHEMA_VALIDATION=true
WORKFLOW_SYNTAX_CHECK=true
