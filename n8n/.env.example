# N8N Configuration
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_PATH=/
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_LICENSE_KEY=a9f1c4fd-978b-45ca-be08-4e3753d91467

# Database Configuration
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n_password

# Security
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
ENCRYPTION_KEY=your-encryption-key-here
MCP_AUTH_TOKEN=your-mcp-auth-token-here

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9100
GRAFANA_PORT=3000

# Execution
EXECUTIONS_MODE=queue
EXECUTIONS_PROCESS=main
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379

# Logging
N8N_LOG_LEVEL=info
LOG_OUTPUT=console,file
LOG_FILE_LOCATION=logs/n8n-%DATE%.log

# Additional Features
GENERIC_TIMEZONE=UTC
N8N_DIAGNOSTICS_ENABLED=true
N8N_BINARY_DATA_TTL=3600
N8N_WORKFLOW_ONBOARDING_SURVEYS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=true
N8N_USER_MANAGEMENT_ENABLED=true

# Copilot Configuration
COPILOT_AGENT_URL=http://localhost:4000
COPILOT_API_KEY=your-copilot-api-key-here
COPILOT_WEBHOOK_SECRET=your-webhook-secret-here

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:4001
MCP_API_KEY=your-mcp-api-key-here
MCP_WEBHOOK_SECRET=your-mcp-webhook-secret-here

# Edge Worker Configuration
EDGE_WORKER_ENABLED=true
EDGE_WORKER_URL=http://localhost:8787
EDGE_WORKER_TOKEN=your-edge-worker-token-here

# GitHub Integration
GITHUB_OWNER=your-github-username
GITHUB_REPO=ContinentalUSA
GITHUB_TOKEN=your-github-token-here
