# n8n Configuration
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=change-me-to-a-secure-key
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-to-a-secure-password
TZ=America/Phoenix

# PostgreSQL Configuration
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-secure-password

# Additional Settings
N8N_METRICS=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_USER_FOLDER=/home/node/.n8n

# CI/CD Integration Settings (optional)
# GITHUB_WEBHOOK_SECRET=your-webhook-secret
# JENKINS_API_TOKEN=your-jenkins-token
# DOCKER_REGISTRY_TOKEN=your-registry-token

# Worker Settings
N8N_EXECUTIONS_PROCESS=main
N8N_METRICS_ENABLED=true

# Email Notifications (optional)
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.example.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=your-smtp-user
# N8N_SMTP_PASS=your-smtp-password

# Security Settings
N8N_BASIC_AUTH_ACTIVE=true
N8N_PROTOCOL=http
N8N_SSL_KEY=
N8N_SSL_CERT=

# Advanced Settings
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_TEMPLATES_HOST=https://api.n8n.io
N8N_HIRING_BANNER_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
