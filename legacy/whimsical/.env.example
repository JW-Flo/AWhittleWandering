# A Whittle Wandering - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# SUPABASE (Required - provided by Lovable Cloud)
# ===========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ===========================================
# MAPBOX (Required for maps)
# ===========================================
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ===========================================
# DEVELOPMENT OVERRIDES (Optional)
# ===========================================
# Uncomment to override default behaviors

# Skip beta access check in development
# VITE_SKIP_BETA_CHECK=true

# Enable debug logging
# VITE_DEBUG=true
