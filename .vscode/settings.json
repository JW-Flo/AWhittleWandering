{
    "roo-cline.rooCodeCloudEnabled": true,
    "roo-cline.vsCodeLmModelSelector": {
        // 1. Vendor to use for all LLM calls. Allowed: "openai" | "anthropic" | "cohere"
        "vendor": "openai",
        // 2. Default model variant for the chosen vendor. Examples: "gpt-4", "gpt-3.5-turbo"
        "model": "gpt-4-turbo",
        // 3. How long (in milliseconds) to wait before aborting an API request.
        "timeoutMs": 30000,
        // 4. Number of times to retry on transient network or rate-limit errors.
        "retryCount": 2
    },
    "app-developer-copilot.useOwnModel": true,
    "app-developer-copilot.apiProvider": "openai",
    "app-developer-copilot.model": "gpt-4o-mini",
    "app-developer-copilot.apiKey": "",
    "editor.experimentalGpuAcceleration": "on",
    "workbench.commandPalette.experimental.suggestCommands": true,
    "workbench.experimental.cloudChanges.autoStore": "onShutdown",
    "workbench.experimental.cloudChanges.partialMatches.enabled": true,
    "workbench.experimental.share.enabled": true,
    "chat.setup.signInWithAlternateProvider": true,
    "chat.tools.autoApprove": true,
    "inlineChat.lineEmptyHint": true,
    "application.experimental.rendererProfiling": true,
    "omnisharp.enableAsyncCompletion": true,
    "omnisharp.enableLspDriver": true,
    "dataWrangler.outputRenderer.columnInsights.displayByDefault": true,
    "dataWrangler.experiments.autoDetectCsvDelimiter": true,
    "dataWrangler.experiments.fastCsvParsing": true,
    "github.copilot.chat.agent.thinkingTool": true,
    "github.copilot.chat.completionContext.typescript.mode": "on",
    "github.copilot.chat.generateTests.codeLens": true,
    "github.copilot.chat.languageContext.fix.typescript.enabled": true,
    "github.copilot.chat.languageContext.inline.typescript.enabled": true,
    "github.copilot.chat.languageContext.typescript.enabled": true,
    "github.copilot.chat.notebook.followCellExecution.enabled": true,
    "gitlens.gitkraken.cli.integration.enabled": true,
    "gitlens.ai.experimental.generateCommits.enabled": true,
    "gitlens.ai.experimental.generateRebase.enabled": true,
    "jupyter.interactiveWindow.notebookRepl": true,
    "python.analysis.addHoverSummaries": true,
    "python.analysis.enablePerfTelemetry": true,
    "python.analysis.enableSyncServer": true,
    "python.analysis.enableTroubleshootMissingImports": true,
    "python.analysis.reportExtraTelemetry": true,
    "python.analysis.supportAllPythonDocuments": true,
    "typescript.tsserver.experimental.enableProjectDiagnostics": true
}