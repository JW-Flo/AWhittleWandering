  "kilo-code.vsCodeLmModelSelector": {},
  "kilo-code.mcpServers": [
    {
      "name": "Qwen-Agent",
      "command": "npx -y @kilo-code/qwen-agent-mcp",
      "autoStart": true,
      "workingDirectory": "/Users/joe/Documents/Cline/MCP/qwen-agent-mcp"
    },
    {
      "name": "Software Planning MCP",
      "command": "node /Users/joe/Documents/Cline/MCP/software-planning-mcp/build/index.js",
      "autoStart": true,
      "workingDirectory": "/Users/joe/Documents/Cline/MCP/software-planning-mcp"
    },
    {
      "name": "Browser Tools MCP",
      "command": "node /Users/joe/Documents/Cline/MCP/browser-tools-mcp/node_modules/@agentdeskai/browser-tools-mcp/dist/mcp-server.js",
      "autoStart": true,
      "workingDirectory": "/Users/joe/Documents/Cline/MCP/browser-tools-mcp"
    }
  ],
  "kilo-code.autoApproveRules": [
    {
      "tool": "execute_command",
      "condition": {
        "requires_approval": false
      },
      "action": "approve"
    },
    {
      "tool": "read_file",
      "condition": {},
      "action": "approve"
    },
    {
      "tool": "write_to_file",
      "condition": {
        "path": "**/*.{md,markdown,txt}"
      },
      "action": "approve"
    },
    {
      "tool": "replace_in_file",
      "condition": {
        "path": "**/*.{md,markdown,txt}"
      },
      "action": "approve"
    },
    {
      "tool": "search_files",
      "condition": {},
      "action": "approve"
    },
    {
      "tool": "list_files",
      "condition": {},
      "action": "approve"
    },
    {
      "tool": "list_code_definition_names",
      "condition": {},
      "action": "approve"
    },
    {
      "tool": "use_mcp_tool",
      "condition": {
        "server_name": "github.com/NightTrek/Software-planning-mcp"
      },
      "action": "approve"
    },
    {
      "tool": "access_mcp_resource",
      "condition": {
        "server_name": "github.com/NightTrek/Software-planning-mcp"
      },
      "action": "approve"
    }
  ],
