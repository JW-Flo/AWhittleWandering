{
  "name": "edge-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npx esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --external:hono --external:zod",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "test:run": "vitest run",
    "test:contract": "vitest run tests/contract",
    "qa:contract": "node dist/qa/unified-contract-check.js",
    "qa:schema": "node dist/qa/validate-unified.js"
  },
  "dependencies": {
    "hono": "^4.1.2",
    "vite": "^6.4.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240320.1",
    "@vitest/web-worker": "^2.1.9",
    "esbuild": "^0.27.2",
    "miniflare": "^4.20251217.0",
    "typescript": "^5.4.2",
    "vitest": "^2.1.9",
    "wrangler": "^4.28.1"
  }
}
