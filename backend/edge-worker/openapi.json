      }
    },
    "/api/v1/admin/status": {
      "get": {
        "tags": ["admin"],
        "summary": "Admin status",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/api/v1/admin/auth/token": {
      "post": {
