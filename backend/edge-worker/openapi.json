{
  "openapi": "3.0.3",
  "info": {
    "title": "A Whittle Wandering API",
    "version": "3.0.0",
    "description": "Cloudflare Worker API surface for AWhittleWandering. This schema is intended for Cloudflare API Shield Schema Validation (OpenAPI v3.0.x; no external refs)."
  },
  "servers": [
    {
      "url": "https://api.awhittlewandering.com"
    }
  ],
  "tags": [
    { "name": "core" },
    { "name": "health" },
    { "name": "telemetry" },
    { "name": "unified" },
    { "name": "trip" },
    { "name": "component" },
    { "name": "analytics" },
    { "name": "vehicle" },
    { "name": "ai" },
    { "name": "admin" },
    { "name": "meta" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "success": { "type": "boolean" },
          "error": { "type": "string" },
          "message": { "type": "string" },
          "timestamp": { "type": "string" }
        },
        "additionalProperties": true
      },
      "AuthRequest": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["login", "register"] },
          "username": { "type": "string", "minLength": 3 },
          "password": { "type": "string", "minLength": 6 }
        },
        "additionalProperties": false
      },
      "TelemetryRequest": {
        "type": "object",
        "required": ["vin", "timestamp", "location", "battery"],
        "properties": {
          "vin": { "type": "string" },
          "timestamp": { "type": "string" },
          "location": {
            "type": "object",
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": { "type": "number" },
              "longitude": { "type": "number" }
            },
            "additionalProperties": false
          },
          "battery": {
            "type": "object",
            "required": ["level", "range"],
            "properties": {
              "level": { "type": "number" },
              "range": { "type": "number" }
            },
            "additionalProperties": false
          },
          "charging": {
            "type": "object",
            "required": ["state"],
            "properties": {
              "state": { "type": "string" },
              "power": { "type": "number" }
            },
            "additionalProperties": false
          },
          "vehicle": {
            "type": "object",
            "required": ["state"],
            "properties": {
              "state": { "type": "string" },
              "odometer": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "AiOptimizeRequest": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "start": { "$ref": "#/components/schemas/LatLng" },
          "end": { "$ref": "#/components/schemas/LatLng" },
          "waypoints": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LatLng" }
          },
          "constraints": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "AiJournalRequest": {
        "type": "object",
        "properties": {
          "date": { "type": "string" },
          "highlights": { "type": "array", "items": { "type": "string" } },
          "context": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      },
      "LatLng": {
        "type": "object",
        "required": ["lat", "lng"],
        "properties": {
          "lat": { "type": "number" },
          "lng": { "type": "number" }
        },
        "additionalProperties": false
      },
      "PlacesIdentifyRequest": {
        "type": "object",
        "required": ["latitude", "longitude"],
        "properties": {
          "latitude": { "type": "number" },
          "longitude": { "type": "number" }
        },
        "additionalProperties": true
      },
      "PlacesAnalyzeStopRequest": {
        "type": "object",
        "required": ["latitude", "longitude"],
        "properties": {
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "duration_minutes": { "type": "number" },
          "arrived_at": { "type": "string" },
          "departed_at": { "type": "string" }
        },
        "additionalProperties": true
      },
      "PlacesCorrectRequest": {
        "type": "object",
        "required": ["latitude", "longitude"],
        "properties": {
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "name": { "type": "string" },
          "place_type": { "type": "string" },
          "place_description": { "type": "string" }
        },
        "additionalProperties": true
      },
      "PlacesBatchAnalyzeRequest": {
        "type": "object",
        "required": ["stops"],
        "properties": {
          "stops": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        },
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": ["core"],
        "summary": "Root service info",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Simple health (legacy)",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/unified-data": {
      "get": {
        "tags": ["unified"],
        "summary": "Legacy redirect to unified data",
        "responses": { "308": { "description": "Redirect" } }
      }
    },
    "/trip-status": {
      "get": {
        "tags": ["trip"],
        "summary": "Legacy redirect to trip status",
        "responses": { "308": { "description": "Redirect" } }
      }
    },
    "/api/v1/trip/status": {
      "get": {
        "tags": ["trip"],
        "summary": "Legacy alias redirect to trip status",
        "responses": { "308": { "description": "Redirect" } }
      }
    },
    "/api/v1/config": {
      "get": {
        "tags": ["core"],
        "summary": "Frontend config",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/connectors": {
      "get": {
        "tags": ["core"],
        "summary": "Demo connectors list",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/joiner": {
      "post": {
        "tags": ["core"],
        "summary": "Demo joiner flow (no request body)",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/auth": {
      "post": {
        "tags": ["core"],
        "summary": "Unified auth action",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["core"],
        "summary": "Authenticated user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": ["health"],
        "summary": "Comprehensive health",
        "responses": {
          "200": { "description": "OK" },
          "503": { "description": "Unhealthy" }
        }
      }
    },
    "/api/v1/health/simple": {
      "get": {
        "tags": ["health"],
        "summary": "Simple health",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/telemetry": {
      "post": {
        "tags": ["telemetry"],
