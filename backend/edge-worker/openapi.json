      }
    },
    "/api/v1/admin/ingest": {
      "post": {
        "tags": ["admin"],
        "summary": "Manual data ingestion",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" }, "207": { "description": "Multi-Status" }, "503": { "description": "Not configured" } }
      }
    },
    "/api/v1/admin/cache/clear": {
      "post": {
        "tags": ["admin"],
        "summary": "Clear caches",
        "security": [{ "bearerAuth": [] }],
