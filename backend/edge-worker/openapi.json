        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/api/v1/admin/data/{resource}": {
      "get": {
        "tags": ["admin"],
        "summary": "Admin data export (allowlisted)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "resource",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "vehicles",
                "journeys",
                "vehicle_state",
                "vehicle_state_history",
                "drives",
                "charges",
                "states_visited",
                "daily_analytics",
                "efficiency_metrics",
                "ingestion_logs",
                "api_cache",
                "media"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "pattern": "^\\d+$" }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "pattern": "^\\d+$" }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/places/providers": {
      "get": {
        "tags": ["core"],
        "summary": "Configured search/AI providers for Places",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/places/identify": {
      "post": {
        "tags": ["core"],
        "summary": "Identify a place at coordinates",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlacesIdentifyRequest" }
            }
          }
        },
        "responses": { "200": { "description": "OK" }, "400": { "description": "Bad request" } }
      }
    },
    "/api/v1/places/analyze-stop": {
