{
    "name": "continentalusa-edge",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/worker.js",
        "deploy": "npx wrangler deploy",
        "dev": "npx wrangler dev --local",
        "upload-static": "node scripts/upload-static.js",
        "prepare-static": "node scripts/prepare-static.js",
        "test": "npm run build && vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "test:ci": "vitest run --coverage --reporter=junit --outputFile=test-results.xml"
    },
    "dependencies": {
        "axios": "^1.6.8",
        "hono": "^4.1.2"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20240320.1",
        "@types/jest": "^29.5.14",
        "@types/node-fetch": "^2.6.11",
        "@vitest/coverage-v8": "^1.4.0",
        "dotenv": "^16.4.5",
        "esbuild": "^0.25.5",
        "miniflare": "^4.20250525.0",
        "typescript": "^5.4.2",
        "vite": "^5.1.6",
        "vitest": "^1.4.0",
        "wrangler": "^4.19.1"
    }
}
