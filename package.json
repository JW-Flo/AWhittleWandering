{
  "name": "continentalusa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:edge": "wrangler build --cwd edge-worker",
    "deploy:edge": "wrangler deploy --cwd edge-worker",
    "build:site": "cd 48Continental_Starter/public-site && npm run build",
    "deploy:site": "cd 48Continental_Starter/public-site && wrangler pages publish ./dist",
    "build:mobile": "./scripts/deploy-mobile.sh",
    "deploy:mobile": "npm run build:mobile && cd ContinentalUSA-mobile && npm run deploy",
    "codegen:ts": "npm --prefix shared run codegen:ts",
    "lint": "eslint edge-worker/src/**/*.ts",
    "test": "npm --prefix edge-worker test && cd ios-client && swift test",
    "pre-deploy": "npm run lint && npm run build:edge && npm run test",
    "deploy": "scripts/deploy-all.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
