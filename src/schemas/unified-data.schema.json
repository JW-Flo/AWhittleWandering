{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnifiedData",
  "type": "object",
  "required": ["id", "timestamp", "data"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}