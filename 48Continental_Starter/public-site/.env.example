# Tessie API Configuration
VITE_TESSIE_API_TOKEN=your_tessie_api_token_here
VITE_TESSIE_VIN=your_tesla_vin_here

# WebSocket Configuration (optional - will use default if not set)
VITE_WEBSOCKET_ENDPOINT=wss://your-edge-worker.workers.dev/vehicle-stream

# Map Configuration
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# API Endpoints (optional - will use relative paths if not set)
VITE_API_BASE_URL=https://your-edge-worker.workers.dev

# Feature Flags
VITE_ENABLE_STREAMING=true
VITE_USE_SIMULATED_DATA=false
