{
  "name": "wandering-whittle",
  "version": "1.0.0",
  "description": "The Wandering Whittle Trip Planner Public Site",
  "type": "module",
  "engines": {
    "node": ">=24.1.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "serve": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:real-data": "./scripts/run-tests-with-real-data.sh",
    "test:analyze": "node scripts/test-analyzer.js",
    "test:capture-failures": "npm run test:real-data || npm run test:analyze",
    "setup": "./scripts/setup-environment.sh",
    "preinstall": "echo 'Skipping Node.js version check for local development'",
    "postinstall": "echo 'Setup complete. Run npm run dev to start development server.'"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "axios": "^1.9.0",
    "gsap": "^3.12.2",
    "intersection-observer": "^0.12.2",
    "mapbox-gl": "^3.4.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "three": "^0.157.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/ui": "^3.2.1",
    "jsdom": "^25.0.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1",
    "wrangler": "^4.19.1"
  }
}
