{
  "name": "wandering-whittle",
  "version": "1.0.0",
  "description": "The Wandering Whittle Trip Planner Public Site",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:validate": "npm run build && node scripts/validate-build.js",
    "verify:mapbox": "bash scripts/verify-mapbox-token.sh",
    "preview": "vite preview",
    "deploy": "npm run build:validate && wrangler pages deploy dist --project-name=awhittlewandering-site",
    "serve": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:real-data": "./scripts/run-tests-with-real-data.sh",
    "test:analyze": "node scripts/test-analyzer.js",
    "test:capture-failures": "npm run test:real-data || npm run test:analyze",
    "test:mapbox": "npm run build && npx serve -s dist -p 4000",
    "setup": "./scripts/setup-environment.sh",
    "preinstall": "echo 'Skipping Node.js version check for local development'",
    "postinstall": "echo 'Setup complete. Run npm run dev to start development server.'"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "gsap": "^3.12.2",
    "hammerjs": "^2.0.8",
    "intersection-observer": "^0.12.2",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.4.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.6.2",
    "three": "^0.157.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/ui": "^3.2.1",
    "jsdom": "^25.0.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1",
    "wrangler": "^4.19.1"
  }
}
