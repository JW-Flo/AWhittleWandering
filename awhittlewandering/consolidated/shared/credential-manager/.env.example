# Security Credential Manager Configuration

# 1Password Connect API Configuration (Primary Credential Source)
ONEPASSWORD_CONNECT_URL=https://1password-connect.your-domain.com
ONEPASSWORD_VAULT_ID=your-vault-id
ONEPASSWORD_CONNECT_TOKEN=your-1password-connect-token

# Secondary Vault (Optional Fallback)
SECONDARY_VAULT_CONNECT_URL=https://backup-1password-connect.your-domain.com
SECONDARY_VAULT_ID=your-backup-vault-id
SECONDARY_VAULT_TOKEN=your-backup-connect-token

# Credential Manager Behavior
# Controls whether to exit process when critical credentials can't be found
# Options: true, false (default: true)
FAIL_ON_MISSING_CRITICAL=true

# Logging Configuration
# Options: debug, info, warn, error (default: info)
CREDENTIAL_LOG_LEVEL=info

# Where to store credential access logs (default: ./credential-access.log)
CREDENTIAL_LOG_PATH=./logs/credential-access.log

# Notification Configuration for Missing Credentials
# Email notification for critical credentials (optional)
ALERT_EMAIL=alerts@your-domain.com

# Webhook URL for missing credential alerts (optional)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-path
