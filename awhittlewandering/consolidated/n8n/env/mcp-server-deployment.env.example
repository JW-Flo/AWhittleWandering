# MCP Server Deployment Workflow Environment Variables
# Copy this file to mcp-server-deployment.env and fill in the values

# GitHub Configuration
GITHUB_OWNER=your-github-username
GITHUB_REPO=ContinentalUSA
GITHUB_TOKEN=your-github-personal-access-token

# MCP Server Configuration
MCP_SERVER_URL=https://mcp-server.example.workers.dev
MCP_API_TOKEN=your-mcp-server-api-token
MCP_SERVER_PATH=/path/to/mcp-server
MCP_SERVER_DOCS_PATH=/path/to/docs/mcp-server-architecture

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# Agent Configuration
AGENT_CLINE_URL=https://agent-cline.example.com
AGENT_CLINE_TOKEN=your-cline-agent-token
AGENT_CLOUDFLARE_URL=https://agent-cloudflare.example.com
AGENT_CLOUDFLARE_TOKEN=your-cloudflare-agent-token
AGENT_COPILOT_URL=https://agent-copilot.example.com
AGENT_COPILOT_TOKEN=your-copilot-agent-token
AGENT_SECURITY_URL=https://agent-security.example.com
AGENT_SECURITY_TOKEN=your-security-agent-token

# Deployment Configuration
DEPLOY_WORKFLOW_ID=your-github-actions-workflow-id
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Debug Options
DEBUG_MODE=false
VERBOSE_LOGGING=false
