# Project Charter Task Automation Environment Variables
# Copy this file to project-charter-automation.env and fill in the values

# Project Information
PROJECT_ROOT=/path/to/your/project
PROJECT_CHARTER_PATH=/path/to/your/project/docs/PROJECT_CHARTER.md
GITHUB_OWNER=your-github-username
GITHUB_REPO=ContinentalUSA
GITHUB_TOKEN=your-github-personal-access-token

# MCP Server Configuration
MCP_SERVER_URL=https://mcp-server.example.workers.dev
MCP_API_TOKEN=your-mcp-server-api-token

# AI Gateway Configuration (for automatic code generation)
AI_GATEWAY_URL=https://ai-gateway.example.com
AI_GATEWAY_TOKEN=your-ai-gateway-token
AI_MODEL=gpt-4-turbo  # or other model used for code generation
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.2  # Lower temperature for more focused code generation

# Notification Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
NOTIFICATION_CHANNEL=project_updates
NOTIFICATION_ENABLED=true

# Auto-deployment Settings
AUTO_COMMIT=true
AUTO_PUSH=true
AUTO_DEPLOY=true  # Whether to trigger deployment after code generation
DEPLOYMENT_WEBHOOK_URL=https://n8n.example.com/webhook/mcp-server/update

# Schedule Settings
CHECK_SCHEDULE="0 9,15 * * *"  # Cron schedule for checking the charter (9 AM and 3 PM)
POLL_INTERVAL=86400  # In seconds, 86400 = once per day

# Advanced Settings
TASK_BATCH_SIZE=1  # Process tasks one at a time
MAX_PARALLEL_TASKS=1  # Don't process tasks in parallel
CODE_GENERATION_TIMEOUT=300  # Timeout for code generation in seconds
DEBUG_MODE=false
VERBOSE_LOGGING=false
