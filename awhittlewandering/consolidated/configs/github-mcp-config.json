{
  "github-mcp": {
    "command": "npx",
    "args": [
      "@github/copilot-github-mcp",
      "--cache-enabled=true",
      "--log-level=info"
    ],
    "env": {
      "GITHUB_TOKEN": "${input:githubToken}",
      "GITHUB_API_URL": "https://api.github.com",
      "GITHUB_CACHE_TTL": "300",
      "GITHUB_GRAPHQL_URL": "https://api.github.com/graphql",
      "GITHUB_MAX_RESULTS": "100",
      "GITHUB_TIMEOUT": "30000"
    }
  },

  "code-analysis-server": {
    "baseUrl": "http://localhost:9011",
    "tools": {
      "analyze_code": {
        "endpoint": "/eslint",
        "method": "POST",
        "description": "Run ESLint on provided code block"
      },
      "type_check": {
        "endpoint": "/tsc",
        "method": "POST",
        "description": "Run TypeScript diagnostics on provided sources"
      },
      "format_code": {
        "endpoint": "/prettier",
        "method": "POST",
        "description": "Return Prettier-formatted version of provided code"
      }
    }
  },

  "doc-processing-server": {
    "baseUrl": "http://localhost:9012",
    "tools": {
      "process_doc": {
        "endpoint": "/extract",
        "method": "POST",
        "description": "Extract plain text preview & metadata from raw text or uploaded file"
      }
    }
  },

  "knowledge-graph-server": {
    "baseUrl": "http://localhost:9013",
    "tools": {
      "kg_query": {
        "endpoint": "/query",
        "method": "POST",
        "description": "Execute Cypher query against local Neo4j (or stub) and return records"
      }
    }
  },

  "deployment-server": {
    "baseUrl": "http://localhost:9014",
    "tools": {
      "trigger_deploy": {
        "endpoint": "/wranglerDeploy",
        "method": "POST",
        "description": "Trigger Cloudflare Wrangler deploy; optional { env } body"
      }
    }
  },

  "test-runner-server": {
    "baseUrl": "http://localhost:9015",
    "tools": {
      "run_tests": {
        "endpoint": "/run_unit",
        "method": "POST",
        "description": "Run vitest unit tests and return JSON summary"
      }
    }
  }
}
