# MCP Server Environment Example

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=production

# Database
DB_PATH=./data/mcp.sqlite

# Security
HMAC_SECRET=changeme

# Edge Worker Integration
EDGE_WORKER_URL=https://continentalusa.workers.dev
EDGE_HMAC_KEY=your-edge-worker-hmac-key

# External APIs
MAPBOX_TOKEN=your-mapbox-token
TESLA_CLIENT_ID=your-tesla-client-id
TESLA_CLIENT_SECRET=your-tesla-client-secret
ABRP_API_KEY=your-abrp-api-key
WEATHER_API_KEY=your-weather-api-key

# Logging
LOG_LEVEL=info
LOG_PATH=./logs
ENABLE_CONSOLE_LOGGING=true

# Agent/Telemetry
TELEMETRY_BUFFER_PATH=./data/telemetry.json
TELEMETRY_SYNC_INTERVAL=300000  # 5 minutes in milliseconds

# Agent Configuration
AGENT_VALIDATION_ENABLED=true
AGENT_HEALTH_CHECK_INTERVAL=60000  # 1 minute in milliseconds

# Web Interface (optional)
ENABLE_ADMIN_UI=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
