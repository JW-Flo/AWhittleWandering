{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-unused-vars": "off",
    "no-console": "off",
    "prefer-const": "off",
    "no-var": "error",
    "no-redeclare": "off",
    "no-undef": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    ".wrangler/",
    "*.min.js",
    "**/*.test.js",
    "**/*.test.jsx",
    "tests/**/*"
  ]
}
