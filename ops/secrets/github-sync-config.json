{
  "version": 1,
  "onePassword": {
    "vault": "AWW_SHARED",
    "item": "prod",
    "items": {
      "development": "dev",
      "production": "prod"
    },
    "allowedSecretNames": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "TESSIE_API_TOKEN",
      "TESSIE_API_KEY",
      "MAPBOX_API_TOKEN",
      "OPENWEATHER_API_KEY",
      "JWT_SECRET",
      "ADMIN_JWT_SECRET",
      "TESLA_VIN",
      "ADMIN_TOKEN",
      "SERPER_API_KEY",
      "BRAVE_API_KEY",
      "TAVILY_API_KEY",
      "SPOTIFY_CLIENT_ID",
      "SPOTIFY_CLIENT_SECRET",
      "NOTIFICATION_WEBHOOK"
    ],
    "denyFieldLabels": [
      "OP_SERVICE_ACCOUNT_TOKEN",
      "1PASS_SYNC_APP_ID",
      "1PASS_SYNC_PRIVATE_KEY",
      "GITHUB_APP_ID",
      "GITHUB_APP_PRIVATE_KEY"
    ],
    "fieldLabelRegex": "^[A-Z][A-Z0-9_]{1,127}$"
  },
  "github": {
    "scope": "repo"
  },
  "behavior": {
    "triggerCloudflareWorkflow": true,
    "cloudflareWorkflowFile": "sync-secrets.yml"
  }
}



