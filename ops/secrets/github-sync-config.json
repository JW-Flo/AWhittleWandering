{
  "version": 1,
  "onePassword": {
    "vault": "AWW_SHARED",
    "item": "prod",
    "items": {
      "development": "dev",
      "production": "prod"
    },
    "denyFieldLabels": [
      "OP_SERVICE_ACCOUNT_TOKEN",
      "1PASS_SYNC_APP_ID",
      "1PASS_SYNC_PRIVATE_KEY",
      "GITHUB_APP_ID",
      "GITHUB_APP_PRIVATE_KEY"
    ],
    "fieldLabelRegex": "^[A-Z][A-Z0-9_]{1,127}$"
  },
  "github": {
    "scope": "repo"
  },
  "behavior": {
    "triggerCloudflareWorkflow": true,
    "cloudflareWorkflowFile": "sync-secrets.yml"
  }
}



