{
  "version": 1,
  "onePassword": {
    "vault": "AWW_SHARED",
    "item": "prod",
    "items": {
      "development": "dev",
      "production": "prod"
    },
    "allowedSecretNames": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "MAPBOX_API_TOKEN",
      "OPENWEATHER_API_KEY",
      "TESSIE_API_TOKEN",
      "TESSIE_API_KEY",
      "TAVILY_API_KEY",
      "SERPER_API_KEY",
      "BRAVE_API_KEY",
      "TESLA_VIN",
      "NOTIFICATION_WEBHOOK",
      "SPOTIFY_CLIENT_ID",
      "SPOTIFY_CLIENT_SECRET"
    ],
    "allowedSecretPrefixes": [
      "JWT_",
      "ADMIN_",
      "CLOUDFLARE_"
    ],
    "secretAliases": {
      "OPEN_WEATHER_API_KEY": "OPENWEATHER_API_KEY",
      "TAVILY_API_TOKEN": "TAVILY_API_KEY"
    },
    "denyFieldLabels": [
      "OP_SERVICE_ACCOUNT_TOKEN",
      "1PASS_SYNC_APP_ID",
      "1PASS_SYNC_PRIVATE_KEY",
      "GITHUB_APP_ID",
      "GITHUB_APP_PRIVATE_KEY",
      "CLOUDFLARE_TOKEN_MANAGER",
      "CLOUDFLARE_API_TOKEN_ID",
      "CLOUDFLARE_API_TOKEN_NAME"
    ],
    "fieldLabelRegex": "^[A-Z][A-Z0-9_]{1,127}$"
  },
  "github": {
    "scope": "repo"
  },
  "behavior": {
    "triggerCloudflareWorkflow": true,
    "cloudflareWorkflowFile": "sync-secrets.yml"
  }
}



