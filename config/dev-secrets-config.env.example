# DEVELOPMENT ENVIRONMENT SECRETS CONFIGURATION (EXAMPLE)
# Copy to `config/dev-secrets-config.env` (not committed) and fill in values.
#
# Then (optionally) run `./apply-dev-secrets.sh` to generate local `.dev.vars`.

# Tesla Integration (REQUIRED)
TESSIE_API_KEY=your_tessie_api_key

# Tesla Vehicle Identification (17 character VIN)
TESLA_VIN=your_vehicle_vin

# Authentication Security (generate a random 32+ character string)
JWT_SECRET=replace_with_random_32_plus_chars

# Map Services (optional)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Weather Data (optional)
OPENWEATHER_API_KEY=your_openweather_api_key

