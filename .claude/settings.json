{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(CLAUDE.md)",
      "Write(.mcp.json)",
      "Write(.claude/**)",
      "Write(backend/**)",
      "Write(frontend/**)",
      "Write(shared/**)",
      "Write(ops/**)",
      "Write(scripts/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(./scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)"
    ],

    "deny": [
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Write(.github/workflows/**)",
      "Write(.github/secrets*)",
      "Bash(*curl*|*bash*)",
      "Bash(*wget*|*bash*)",
      "Bash(rm -rf*)",
      "Bash(*rm*-rf*)"
    ]
  }
}
