{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(CLAUDE.md)",
      "Write(.mcp.json)",
      "Write(backend/**)",
      "Write(frontend/**)",
      "Write(shared/**)",
      "Write(ops/**)",
      "Write(scripts/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Write(.github/workflows/ci.yml)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(npm *)"
    ],

    "deny": [
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Write(.claude/**)",
      "Write(.github/workflows/**)",
      "Bash(curl * | bash)",
      "Bash(rm -rf *)"
    ]
  }
}
