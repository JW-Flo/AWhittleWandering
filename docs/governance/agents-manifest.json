{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "0.1.0",
  "lastUpdated": "2025-10-03T00:15:00Z",
  "roles": [
    {
      "id": "docs-curator",
      "description": "Maintains architectural & coordination docs; ensures invariants section accuracy.",
      "permissions": ["append_change_feed", "update_docs", "add_schema_optional"],
      "primaryFiles": [
        ".github/copilot-instructions.md",
        "ROADMAP.md",
        "docs/governance/live-change-feed.schema.json"
      ]
    },
    {
      "id": "analytics-aggregator",
      "description": "Creates & optimizes cached analytics endpoints and batch jobs.",
      "permissions": [
        "append_change_feed",
        "add_endpoint",
        "add_cache_entry",
        "extend_health_metrics"
      ],
      "primaryFiles": ["backend/edge-worker/src/index.ts", "backend/edge-worker/src/analytics/"]
    },
    {
      "id": "frontend-integrator",
      "description": "Integrates new backend features into UI using React Query and config endpoint.",
      "permissions": ["append_change_feed", "extend_frontend_hooks"],
      "primaryFiles": ["frontend/src/hooks/", "frontend/src/lib/"]
    },
    {
      "id": "qa-gatekeeper",
      "description": "Extends QA scripts for contract/schema & governance compliance.",
      "permissions": ["append_change_feed", "add_qa_script", "enforce_seq", "validate_schema"],
      "primaryFiles": ["qa/"]
    },
    {
      "id": "codex-runner",
      "description": "External generation agent producing draft code under invariant compliance.",
      "permissions": ["append_change_feed", "propose_refactor", "add_endpoint"],
      "primaryFiles": [".github/copilot-instructions.md", "docs/governance/live-change-log.ndjson"]
    },
    {
      "id": "kline-runner",
      "description": "Strategic planner; produces architecture deltas read-only unless paired with docs-curator.",
      "permissions": ["append_change_feed"],
      "primaryFiles": ["ROADMAP.md"]
    },
    {
      "id": "cline-runner",
      "description": "Refactoring + structure normalization executor.",
      "permissions": ["append_change_feed", "apply_restructure", "update_imports"],
      "primaryFiles": [
        "docs/restructure/REPO_RESTRUCTURE_PLAN.md",
        "docs/restructure/file-normalization-rules.md"
      ]
    }
  ],
  "coordination": {
    "seqRequired": true,
    "conflictPolicy": "rebase_increment",
    "changeFeed": "docs/governance/live-change-log.ndjson",
    "schema": "docs/governance/live-change-feed.schema.json"
  }
}


