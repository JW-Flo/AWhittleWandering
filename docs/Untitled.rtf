Minimal runtime \'96 src/runner.ts\
\
bash\
Copy\
Edit\
cat <<'TS' > uxui-agent/src/runner.ts\
import fetch from "node-fetch";\
\
declare const FIGMA_TOKEN: string;\
\
export async function handleAgentTask(t: any) \{\
  switch (t.type) \{\
    case "syncTokens":\
      return await syncTokens(t.fileKey);\
    case "genComponent":\
      return \{ tsx: stubComponent(t.nodeId) \};\
    case "validate":\
      return \{ ok: "noop" \};\
    default:\
      throw new Error(`unknown task $\{t.type\}`);\
  \}\
\}\
\
async function syncTokens(fileKey: string) \{\
  const r = await fetch(`https://api.figma.com/v1/files/$\{fileKey\}`, \{\
    headers: \{ "X-Figma-Token": FIGMA_TOKEN \},\
  \});\
  if (!r.ok) throw new Error(`Figma $\{r.status\}`);\
  const j = await r.json();\
  const styles = Object.values(j.styles ?? \{\});\
  return \{ tokenCount: styles.length \};\
\}\
\
function stubComponent(nodeId: string) \{\
  const safe = nodeId.replace(/[:]/g, "_");\
  return `export default function $\{safe\}() \{ return <div className="rounded bg-muted p-4"></div>; \}`;\
\}\
TS\
GitHub Action \'96 .github/workflows/uxui-agent.yml\
\
bash\
Copy\
Edit\
mkdir -p .github/workflows\
cat <<'YAML' > .github/workflows/uxui-agent.yml\
name: Deploy UXUI-Agent\
on:\
  push:\
    paths:\
      - "uxui-agent/**"\
jobs:\
  deploy:\
    runs-on: ubuntu-latest\
    defaults: \{ run: \{ working-directory: uxui-agent \} \}\
    steps:\
      - uses: actions/checkout@v4\
      - uses: actions/setup-node@v4\
        with: \{ node-version: 20 \}\
      - run: npm install -g wrangler\
      - run: npm ci\
      - run: wrangler publish --env production --minify\
        env:\
          CLOUDFLARE_API_TOKEN: $\{\{ secrets.CF_API_TOKEN \}\}\
          CF_ACCOUNT_ID: $\{\{ secrets.CF_ACCOUNT_ID \}\}\
