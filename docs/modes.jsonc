{
  "modes": [
    {
      "name": "Full Refactor Mode",
      "intent": ["refactor","tech-debt","modularize","upgrade deps"],
      "required_steps": [
        "Map modules & ownership",
        "Propose refactor plan",
        "Apply atomic diffs",
        "Run lint/tests",
        "Run Semgrep/Bandit/Sonar hints",
        "Instrument tracing/logging/metrics",
        "Update docs & PR"
      ],
      "tool_hints": ["codebase","editFiles","runTests","problems","search","mcp:sequentialthinking"],
      "success_criteria": ["All tests pass","Security scan clean or acceptable","No API breakage","Perf not worse"],
      "rollback": "Revert diff or open PR with revert branch"
    },
    {
      "name": "Feature Implementation Mode",
      "intent": ["add feature","implement","scaffold","extend api","frontend"],
      "required_steps": [
        "Spec the feature & impacts",
        "Add backend endpoints/handlers",
        "Update frontend or worker bindings",
        "Add tests (unit/integration)",
        "Add telemetry for new paths",
        "Docs & PR with migration notes if any"
      ],
      "tool_hints": ["editFiles","runTests","runTasks","githubRepo","search"],
      "success_criteria": ["Feature e2e demo works","Coverage not reduced","Security posture maintained"],
      "rollback": "Feature flag off or revert commit"
    },
    {
      "name": "Security Audit Mode",
      "intent": ["security","audit","pentest","sast","dast","threat model"],
      "required_steps": [
        "Enumerate trust boundaries",
        "Run Semgrep/Bandit/Trivy",
        "Patch high/critical",
        "Add input validation & authz checks",
        "Regenerate SBOM (if applicable)",
        "Write JSON report & PR comments"
      ],
      "tool_hints": ["runCommands","runTests","problems","openSimpleBrowser"],
      "success_criteria": ["No critical vulns","Documented residual risk","CI gates updated"],
      "rollback": "Disable risky change and open follow-up issue"
    },
    {
      "name": "Deployment Mode",
      "intent": ["deploy","release","promote","rollout","publish"],
      "required_steps": [
        "Terraform fmt/validate/plan",
        "Wrangler build for workers",
        "Run CI workflow dispatch",
        "Health check & smoke tests",
        "Canary or staged rollout if configured",
        "Prepare rollback"
      ],
      "tool_hints": ["runTasks","runCommands","githubRepo","terminalLastCommand"],
      "success_criteria": ["Green deploy","Health checks pass","No new errors in logs/metrics"],
      "rollback": "Terraform destroy targeted or previous Worker version"
    },
    {
      "name": "Research & Architecture Mode",
      "intent": ["research","rfc","spec","design","architecture","diagram"],
      "required_steps": [
        "Collect sources (RFCs, best practices)",
        "Compare options & trade-offs",
        "Propose architecture & diagrams (mermaid)",
        "Security/privacy implications",
        "Implementation roadmap",
        "Add ADR to docs"
      ],
      "tool_hints": ["openSimpleBrowser","search","think","mcp:memory"],
      "success_criteria": ["Cited sources","Actionable plan","Approved ADR"],
      "rollback": "Supersede ADR with revision"
    }
  ]
}
